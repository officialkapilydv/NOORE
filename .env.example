# Copy this file to ".env" (same folder) to override the Docker defaults.
# Docker Compose reads it automatically.

# Port on your machine for the storefront + admin + API (container always listens on 4000)
NOORE_PORT=4000

# Security — change before exposing the site to anyone else
# (Left unset or at these placeholders in production, the server generates its own JWT secret and
#  keeps it in the data volume, and the x-admin-key header stays disabled.)
JWT_SECRET=replace-with-a-long-random-string
ADMIN_KEY=replace-with-another-random-string

# Set to 1 only when a reverse proxy (nginx, Caddy, a load balancer) sits in front of the container,
# so rate limits see real visitor IPs. Without a proxy, leave it off or visitors could fake their IP.
# TRUST_PROXY=1

# First administrator (created on the very first start, when the data volume is empty)
ADMIN_EMAIL=admin@noore.in
ADMIN_PASSWORD=noore-admin-2026
ADMIN_NAME=Studio admin
